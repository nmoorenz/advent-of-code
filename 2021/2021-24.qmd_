    }
}
```

I want to do this methodically.

Also maybe I want to go through the instructions and make sure there are no gotchas because this is Advent of Code and obviously there are going to be some gotchas.

Anyway, backwards from 10\^14-1, recording what I have checked.

```{r}
max = 10**14-1
write(as.character(max), file='day24tracking.txt')
min = max
```

```{r}

# decrease the numbers, based on what we've already searched
# I sure hope the algorithm is correct
# return a character vector of length len

dec_numbers <- function(len) {
    nums = c()
    k = 0
    i = as.double(readLines('day24tracking.txt'))
    # print(nums)
    # print(i)
    while (k < len) {
        j = as.character(i)
        # print(j)
        if (str_detect(j, "0")) {
            # skip
            # print("has a zero")
        } else {
            nums = append(nums, j)
            k = k + 1
        }
        i = i - 1
        # k = k + 1
    }
    
    write(j, file='day24tracking.txt')
    return(nums)
}


```

Use the numbers function to get us some samples

```{r}

# dec_numbers(10)

nums = dec_numbers(10000)
# min = max

for (n in nums) {
    # print(n)
    res = process_number(n, inst)
    # print(paste("result: ", res))
    if (res == 0) {
        print(n)
    }
    if (res < min) {
        # print(res)
        min = res
    }
}
```
