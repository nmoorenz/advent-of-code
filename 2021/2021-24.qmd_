Ready to try some numbers!

```{r}

# min = max
nums = get_numbers(1000)


for (n in nums) {
    # print(n)
    res = process_number(n, inst)
    # print(paste("result: ", res))
    if (res == 0) {
        print(n)
    }
    if (res < min) {
        print(n)
        print(res)
